# Brewfile — install everything with: brew bundle

# Core
brew "git"
brew "stow"
brew "go-task"

# Python
brew "python@3.12"
brew "uv"              # fast Python package manager

# Shell utilities
brew "fzf"             # fuzzy finder (history, file search)
brew "zoxide"          # smarter cd — jumps to frecent directories
brew "eza"             # modern ls with colours and icons
brew "bat"             # modern cat with syntax highlighting
brew "ripgrep"         # fast grep (used by editors and fzf)
brew "jq"              # JSON processor — essential for API work

# Editor
brew "vim"
